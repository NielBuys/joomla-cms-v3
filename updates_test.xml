<?xml version="1.0" encoding="utf-8"?>
<updates>
	<!--
		Release candidates and betas for the "Testing" update channel of the NielBuys/joomla-cms-v3 fork.
		Referenced by list_test.xml (detailsurl). Served at:
		https://raw.githubusercontent.com/NielBuys/joomla-cms-v3/3.10-dev/updates_test.xml

		Per test release, only once its GitHub pre-release and archives are published: add an
		<update> block like the ones in updates.xml, with
		  - <version> set to the full version, for example 3.12.0-rc1
		  - <tags><tag>rc</tag></tags> (or beta, alpha), which Minimum Stability filters on
		  - <php_minimum> set to the release's minimum PHP version
		then set list_test.xml's version attribute to the same version and push.

		When the stable release follows, add its <update> block here as well, so sites on the
		Testing channel move from the release candidate to the stable release.
	-->
</updates>
