{
    "name": "joomla/joomla-cms",
    "type": "project",
    "description": "Fork of Joomla! CMS v3",
    "keywords": ["joomla", "cms"],
    "homepage": "https://github.com/NielBuys/joomla-cms",
    "license": "GPL-2.0-or-later",
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "vendor-dir": "libraries/vendor",
        "github-protocols": ["https"],
        "audit": {
            "ignore": {
                "PKSA-5x9t-bkbj-vmgp": "joomla/filter CVE-2025-54476: fixed in the NielBuys/j3_filter fork"
            }
        }
    },
    "support": {
        "issues": "https://github.com/NielBuys/joomla-cms/issues"
    },
    "repositories": [
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaApplication.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaData.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaDI.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaEvent.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaFilesystem.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/j3_filter"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaImage.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaInput.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaLdap.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaRegistry.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaSession.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/JoomlaString.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/recaptcha.git"
      },
      {
        "type": "vcs",
        "url": "https://github.com/NielBuys/simplepie.git"
      }
    ],
    "require": {
        "php": ">=8.3.0",
        "joomla/application": "^1.9.5",
        "joomla/archive": "^1.1.7",
        "joomla/data": "^1.2.1",
        "joomla/di": "^1.5.2",
        "joomla/event": "^1.3.1",
        "joomla/filter": "^1.4.9",
        "joomla/image": "^1.5.2",
        "joomla/input": "^1.5.1",
        "joomla/ldap": "^1.5.1",
        "joomla/registry": "^1.6.6",
        "joomla/session": "^1.6.1",
        "joomla/string": "^1.4.7",
        "joomla/uri": "~1.2",
        "joomla/utilities": "^1.6",
        "paragonie/random_compat": "^2.0.21",
        "paragonie/sodium_compat": "2.5.2",
        "phpmailer/phpmailer": "^7.1",
        "symfony/yaml": "^7.4.18",
        "simplepie/simplepie": "1.3.4",
        "google/recaptcha": "1.2.5",
        "typo3/phar-stream-wrapper": "^4.0",
        "php81_bc/strftime": "^0.5.0",
        "splitbrain/lesserphp": "^0.10.2",
        "pear/cache_lite": "^1.8",
        "symfony/polyfill-mbstring": "^1.33"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3",
        "squizlabs/php_codesniffer": "^3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
