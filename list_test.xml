<?xml version="1.0" encoding="utf-8"?>
<!--
	Joomla CMS update collection for the "Testing" update channel of the NielBuys/joomla-cms-v3 fork.

	Joomla Update reads this file when Options > Update Channel is "Testing". It points at
	updates_test.xml, which holds release candidates and betas. Sites only see them when
	Options > Minimum Stability is low enough (for example "Release Candidate").

	Served at: https://raw.githubusercontent.com/NielBuys/joomla-cms-v3/3.10-dev/list_test.xml
	The URL is set in administrator/components/com_joomlaupdate/models/default.php.

	Set the version attribute to the newest version in updates_test.xml. Joomla skips
	updates_test.xml unless this version is newer than the installed one.
-->
<extensionset name="Joomla! Core testing (NielBuys fork)" description="Joomla 3 fork - release candidates and betas">
	<extension name="Joomla" element="joomla" type="file" version="3.11.18" detailsurl="https://raw.githubusercontent.com/NielBuys/joomla-cms-v3/3.10-dev/updates_test.xml"/>
</extensionset>
